#!/usr/bin/env bash
# Build the Tailwind/daisyUI CSS with the gem source paths resolved at build time.
#
# Tailwind must scan the Ruby that emits class names — including the daisyui and
# docs-kit GEMS, whose install location differs by environment (a global gem dir
# in local dev, a vendored .bundle/gems in the Docker image). Rather than hardcode
# a relative @source that only works in one layout, resolve the gem paths with
# `bundle show` and write them into a generated sources file the CSS @imports.
set -euo pipefail

cd "$(dirname "$0")/.."

GENERATED="app/assets/stylesheets/tailwind.sources.css"

# Resolve each required gem's path up front and FAIL FAST if any is missing.
# A silently-skipped @source would drop that gem's component classes from the
# production CSS with no build error — and since docs-kit is the whole point of
# this site's chrome, that would be a hard-to-debug regression. Better to break
# the build here than ship an unstyled site.
sources=""
for gem in daisyui docs-kit; do
  if ! path="$(bundle show "$gem" 2>/dev/null)"; then
    echo "bin/build-css: could not resolve gem path for '$gem' (bundle show failed)." >&2
    echo "  Tailwind would drop its component classes from the build. Aborting." >&2
    exit 1
  fi
  sources+="@source \"${path}/**/*.rb\";"$'\n'
done

{
  echo "/* GENERATED by bin/build-css — do not edit. Gem @source globs for Tailwind. */"
  printf '%s' "$sources"
} > "$GENERATED"

MODE="${1:---minify}"
exec bunx @tailwindcss/cli \
  -i ./app/assets/stylesheets/application.tailwind.css \
  -o ./app/assets/builds/application.css \
  "$MODE"
