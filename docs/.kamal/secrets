# Secrets are fetched from 1Password at deploy time (no plaintext in the repo),
# per oss-infrastructure/docs/adding-a-new-gem.md. Requires OP_SERVICE_ACCOUNT_TOKEN
# in the environment (set as a GitHub Actions secret on the `docs` environment).

SECRETS=$(kamal secrets fetch \
  --adapter 1password \
  --account my.1password.com \
  --from oss-infrastructure/phlex-reactive-docs \
  rails_master_key postgres_password)

RAILS_MASTER_KEY=$(kamal secrets extract rails_master_key ${SECRETS})
POSTGRES_PASSWORD=$(kamal secrets extract postgres_password ${SECRETS})

# GitHub Container Registry token (the deploy workflow's GITHUB_TOKEN).
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
