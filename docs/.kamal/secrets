# This is a throwaway demo site with NO managed secrets: SECRET_KEY_BASE and the
# DB password are inline in config/deploy.yml (see the rationale there). The app
# reads no Rails encrypted credentials, so there is no master key and no
# 1Password fetch. The only credential Kamal needs is the registry token.
#
# In CI the deploy workflow exports KAMAL_REGISTRY_PASSWORD from the built-in
# GITHUB_TOKEN; locally that var is unset, so fall back to the gh CLI token.
KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD:-$(gh auth token)}
